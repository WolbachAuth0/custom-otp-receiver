<%- include('partials/header') -%>

<main>
  
  <div class="container py-4 mt-4">

    <div class="card border-primary bg-light mb-3">
      <div class="card-body">
        
        <h4 class="card-title text-primary mb-4">
          <i class="bi bi-chat fs-1 text-primary"></i>
          Messages
        </h4>

<%   for (let message of messages) { %>
        <div class="card border-primary mb-3">
          <div class="card-header clearfix text-start">
            <span class="text-success">
              <span class="strong">TO:</span>
              <%= message.recipient %>
            </span>
            <span class="text-primary-emphasis float-end">
              <span class="strong">From:</span>
              <%= message?.tenant %>
            </span>
          </div>

          <div class="card-body">
            <h4 class="card-title text-primary"><%= message.body %></h4>
          </div>

          <div class="card-footer clearfix text-start">
            <span class="text-muted">
              <%= new Date(message.timestamp).toLocaleString() %>
              <span class="float-end"> message_id: <%= message.message_id %> </span>
            </span>
          </div> 
        </div>
<%   } %>

      </div>
    </div>

  </div>
</main>

<%- include('partials/footer') -%>