<%- include('partials/header') -%>

<main>
  <div class="container pt-4 bg-secondary">

    <div class="card border-light mb-3">
      <div class="card-body">
        
        <h4 class="card-title text-primary mb-4">
          <i class="bi bi-chat fs-1 text-primary"></i>
          Messages
        </h4>

<%   for (let message of messages) { %>
        <div class="card border-info mb-3">
          <div class="card-header">To: <%= message.recipient %></div>
          <div class="card-body">
            <h4 class="card-title text-success"><%= message.body %></h4>
          </div>
          <div class="card-footer text-muted">
            message_id: <%= message.message_id %>, timestamp: <%= new Date(message.timestamp).toLocaleString() %>
          </div> 
        </div>
<%   } %>

      </div>
    </div>

  </div>
</main>

<%- include('partials/footer') -%>