<%- include('partials/header') -%>

<main>
  <div class="container">

    <div class="pt-4">
      
      <%   for (let message of messages) { %>
      <div class="card border-info mb-3">
        <div class="card-header">To: <%= message.recipient %></div>
        <div class="card-body">
          <h4 class="card-title">ID: <%= message.message_id %></h4>
          <p class="card-text"><%= message.body %></p>
        </div>
      </div>
      <%   } %>

    </div>
  </div>
</main>

<%- include('partials/footer') -%>